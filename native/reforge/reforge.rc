#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION REFORGE_VERSION_NUM
PRODUCTVERSION REFORGE_VERSION_NUM
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Reforge contributors"
            VALUE "FileDescription", "Reforge asset redirect for Warhammer 40,000: Darktide mods"
            VALUE "FileVersion", REFORGE_VERSION_STR
            VALUE "InternalName", "reforge"
            VALUE "LegalCopyright", "MIT licence. Source: https://github.com/Vansinnet/Reforge"
            VALUE "OriginalFilename", "reforge.dll"
            VALUE "ProductName", "Reforge"
            VALUE "ProductVersion", REFORGE_VERSION_STR
            VALUE "Comments", "Serves read-only opens of game bundle files from files inside the game's mods folder. Hooks CreateFileW/CreateFileA/CreateFile2 in this process only. No network, no writes, no game memory patching beyond the three hooks."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
